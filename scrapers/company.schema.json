{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Boardroom company snapshot",
  "description": "Lean company and financial data with source URLs, units and parsing warnings. Accounting views are never mixed; financial labels are preserved.",
  "type": "object",
  "required": [
    "symbol",
    "name",
    "view",
    "source_url",
    "scraped_at",
    "company_id",
    "fallback_reason",
    "profile",
    "key_ratios",
    "documents",
    "units",
    "quarterly_results",
    "balance_sheet",
    "cash_flow",
    "ratios",
    "warnings",
    "profit_loss",
    "shareholding"
  ],
  "properties": {
    "symbol": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "view": {
      "type": "string",
      "enum": [
        "consolidated",
        "standalone"
      ]
    },
    "source_url": {
      "type": "string"
    },
    "scraped_at": {
      "type": "string",
      "format": "date-time"
    },
    "company_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "fallback_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "profile": {
      "type": "object",
      "required": [
        "website",
        "bse_code",
        "nse_code"
      ],
      "properties": {
        "website": {
          "type": [
            "string",
            "null"
          ]
        },
        "bse_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "nse_code": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "key_ratios": {
      "type": "object"
    },
    "documents": {
      "type": "object",
      "required": [
        "annual_reports",
        "concalls",
        "credit_ratings",
        "announcements"
      ],
      "properties": {
        "annual_reports": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "year",
              "url",
              "source"
            ],
            "properties": {
              "year": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "url": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "source": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "additional_links": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "type",
                    "url"
                  ],
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        },
        "concalls": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "period",
              "transcript_url",
              "presentation_url",
              "recording_url"
            ],
            "properties": {
              "period": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "transcript_url": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "presentation_url": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "recording_url": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "additional_links": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "type",
                    "url"
                  ],
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        },
        "credit_ratings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "date",
              "date_text",
              "agency",
              "url"
            ],
            "properties": {
              "date": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "date_text": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "agency": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "url": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "additional_links": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "type",
                    "url"
                  ],
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        },
        "announcements": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "date",
              "title",
              "description",
              "url"
            ],
            "properties": {
              "date": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "title": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "description": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "url": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "additional_links": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "type",
                    "url"
                  ],
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": true
    },
    "units": {
      "type": "object"
    },
    "quarterly_results": {
      "$ref": "#/$defs/period_table"
    },
    "balance_sheet": {
      "$ref": "#/$defs/period_table"
    },
    "cash_flow": {
      "$ref": "#/$defs/period_table"
    },
    "ratios": {
      "$ref": "#/$defs/period_table"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "profit_loss": {
      "type": "object",
      "required": [
        "annual",
        "growth"
      ],
      "properties": {
        "annual": {
          "$ref": "#/$defs/period_table"
        },
        "growth": {
          "type": "object"
        }
      }
    },
    "shareholding": {
      "type": "object",
      "required": [
        "quarterly",
        "yearly"
      ],
      "properties": {
        "quarterly": {
          "$ref": "#/$defs/period_table"
        },
        "yearly": {
          "$ref": "#/$defs/period_table"
        }
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "period_table": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "required": [
          "period",
          "period_end"
        ],
        "properties": {
          "period": {
            "type": "string"
          },
          "period_end": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "raw_pdf_url": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    }
  }
}
